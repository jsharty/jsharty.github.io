@article{katz2025,
  title = {The {{Transition-Age Youth Special Interest Group}}: {{The Establishment}} and {{Activities}} of a {{U}}.{{S}}.-{{Based Network}} of {{Child Welfare Researchers}}},
  author = {Katz, Colleen C and Jackson, Sebrena and Dworsky, Amy and Okpych, Nathanael J and Cheatham, Leah P and \hartyjsdot{Harty, Justin S.} and Powers, Jenna and Salazar, Amy M and Shpiegel, Svetlana and Munson, Michelle R and Blakeslee, Jennifer E and Geiger, Jennifer M and Havlicek, Judy and Johnson, Royel M and Taussig, Heather and Courtney, Mark},
  date = {2025},
  journaltitle = {Families in Society: The Journal of Contemporary Social Services},
  shortjournal = {Fam. Soc. J. Contemp. Soc. Serv.},
  pages = {1--15},
  doi = {10.1177/10443894251316394},
  abstract = {This paper provides an overview of the history and current activities of a group of researchers focused on the experiences of young people who “age out” of foster care in the United States. These transition-age youth (TAY) often have intersecting marginalized identities, as youth of color, queer youth, and youth with disabilities are disproportionately represented in care. Members of the Transition-Age Youth Special Interest Group (TAY-SIG) conduct research in several key domains, many addressing the discrimination, trauma, and poverty experienced by the majority of TAY. We report on the cutting-edge research happening in these areas and highlight the gaps in the research that require urgent attention. Despite these gaps, we argue that research undertaken by TAY-SIG members has driven the field of TAY research forward in a variety of timely and important ways.},
  langid = {english},
  keywords = {cv-pub-journal},
  file = {/Users/j-macmini/Zotero/storage/43HLAWZ6/Katz et al. - 2025 - The Transition-Age Youth Special Interest Group The Establishment and Activities of a U.S.-Based Ne.pdf}
}

