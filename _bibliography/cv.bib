  abstract = {This scoping review examines the challenges fathers of color face at the intersections of the child welfare system and family support, child support, and criminal justice systems. By reviewing literature from 2008 to 2023, significant gaps were identified in how these systems impact these fathers. The study highlights the need for expanded empirical research, culturally competent interventions, and policy reforms to address systemic inequities and improve outcomes for fathers and their families.},
  keywords = {cv-pub-journal}
}

@article{harty2025d,
  title = {Origins of Opportunity, Part 1: {{The}} Formation of {{CSWE}}’s Minority Research Fellowship Program, 1954–1978},
  author = {\hartyjsdot{Harty, Justin S.} and BlackDeer, Autumn Asher and Schiele, Jerome H. and Francis, E. Aracelis and Washington, Durrell M.},
  date = {2025},
  journaltitle = {Journal of Social Work Education},
  shortjournal = {J. Soc. Work Educ.},
  volume = {61},
  number = {S1},
  pages = {S4-S20},
  doi = {10.1080/10437797.2024.2407826},
  abstract = {This paper explores the historical development of the Council on Social Work Education's (CSWE) Minority Fellowship Program (MFP), coinciding with the 50th anniversary of its research fellowship. By leveraging archival CSWE materials like meeting minutes, reports, letters, and newsletters, it chronicles key events from 1954 that culminated in the MFP's creation in 1973 and extends to the third research fellowship cohort in 1978, just before the introduction of the second clinical fellowship. The paper details the challenges and milestones that shaped early initiatives for diversity and inclusion within social work education. It offers a reflective examination of the MFP's inception, tracing the advocacy and structural changes within the CSWE and broader social movements that culminated in the creation of the MFP and its sustained impact on the profession. Established to address the underrepresentation of minorities in social work education, the MFP was designed to develop researchers and practitioners of color attuned and responsive to the varied needs of their communities. This paper not only enriches the social work historical record but also highlights the transformative impact of the MFP in cultivating a profession that truly reflects and effectively serves our racially and ethnically diverse society.},
  keywords = {cv-pub-journal},
  file = {/Users/j-macmini/Zotero/storage/Y5N5WCD3/Harty et al. - 2025 - Origins of opportunity, part 1 The formation of CSWE’s minority research fellowship program, 1954–1.pdf}
}

