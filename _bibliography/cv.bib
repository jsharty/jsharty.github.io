@article{murray2026,
  title = {Accountability or Complicity? {{Social}} Work’s Dual Commitments and Crisis of Accountability in the {{US}}},
  shorttitle = {Accountability or Complicity?},
  author = {Murray, Bethany Jo and \hartyjsdot{Harty, Justin S.} and Dettlaff, Alan J.},
  date = {2026},
  journaltitle = {Critical and Radical Social Work},
  shortjournal = {Crit. Radic. Soc. Work},
  volume = {Preprint},
  pages = {1--19},
  publisher = {Policy Press},
  issn = {2049-8608, 2049-8675},
  url = {https://bristoluniversitypressdigital.com/view/journals/crsw/aop/article-10.1332-20498608Y2025D000000118/article-10.1332-20498608Y2025D000000118.xml},
  urldate = {2026-01-29},
  abstract = {The social work profession in the US espouses commitments to equity and justice while also being complicit in systems of racial and social oppression, revealing a persistent accountability crisis within the profession. This article traces the historical and contemporary dimensions of that crisis, asking: To whom is social work accountable? Through archival research and analysis of contemporary case studies, we trace how professional bodies have defined, regulated, and enforced accountability since the 1970s. We argue that professional regulation, codified during this period, aligned social work with state power by prioritizing risk management and professional legitimacy politics over accountability to marginalized communities. Amid authoritarian resurgence and the suppression of marginalized communities, these alignments demand renewed scrutiny. Using accountability as a central analytic, this article contends that ethical practice in social work requires moving beyond compliance with state regulation and toward collective responsibility to communities.},
  langid = {english},
  keywords = {cv-pub-journal}
}

