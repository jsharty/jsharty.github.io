@unpublished{decoursey2022,
  type = {Invited session discussant},
  title = {Reconnecting Youth to Education and Employment: Incorporating Multiple Disciplines and Methods to Synthesize the Research and Enhance Innovation},
  author = {DeCoursey, Jan and \hartyjsdot{Harty, Justin S.}},
  date = {2022-11-17},
  url = {https://appam.confex.com/appam/2022/meetingapp.cgi/Session/16910},
  abstract = {In the United States, approximately 4.8 million young people between the ages of 16 and 24 are neither employed nor in school. These young people are often referred to as “disconnected youth” or “opportunity youth.” The process of disconnection and reconnection from education and employment is complex, influenced by diverse and interconnected structural, system, community, familial, and individual factors. Relatedly, diverse research disciplines, study methods, public policies, and interventions exist to identify and address the ways youth connect to education and employment. The papers on this panel will describe four distinct approaches to synthesizing what is known about youth disconnection and reconnection and explore how to apply the findings to advance policy, interventions, and future policy research. The projects and their associated papers describe unique approaches and distinct methods to integrating knowledge across a wide range of disciplines including education, labor, developmental psychology, family and child policy, justice policy, and poverty and income policy, among other fields. The first paper lays the groundwork for the panel by describing findings from an evidence gap map that systematically summarizes the available research about programs in the United States and the practices used to support young people who experience disconnection from school and work during their transition to adulthood. The findings from the evidence gap map show that most programs incorporate comprehensive approaches that integrate knowledge across a range of fields to address disconnection. The second paper will explore disconnection from a wider lens, presenting findings from simulations of public policies and large public programs aimed at improving the ways young people may move on an upward or downward path of economic mobility. The findings provide a sense of how various policy interventions including, for example, education and criminology, might benefit youth and identify strategies and interventions that policymakers and the public may view as worthy of further investment. The third paper stays focused on data analytics, zooming in on findings about the development of a casework tool that one comprehensive program for young people who experience the child welfare and justice system is using to tailor education, employment, housing, and social support services to suit each youth’s circumstances. The tool uses participant and program data and quasi-experimental analytic techniques to generate individualized and interactive developmental, behavioral, educational, and employment service recommendations and milestones for each participant. The final paper re-focuses on young peoples’ voices and uses participatory action research to explore the ways young people who experience homelessness describe their employment experiences and perspectives on their careers. The findings highlight a broad range of opportunities – through both practice and policy approaches – to further support youth facing homelessness on their journeys toward self-sufficiency. Taken together, the panel will reinforce the central theme that an interdisciplinary approach – both in terms of methods applied and how multiple disciplines intersect to influence how young people disconnect and reconnect - strengthens understanding and creates new opportunities for problem solving and innovation.},
  venue = {Association for Public Policy Analysis \& Management 44th Annual Research Conference, Washington, D.C.},
  keywords = {cv-conf-discussant},
  file = {/Users/j-macmini/Zotero/storage/8BH86KJA/DeCoursey and Harty - 2022 - Reconnecting youth to education and employment incorporating multiple disciplines and methods to sy.pdf;/Users/j-macmini/Zotero/storage/M8PH7JFL/Conference-2022-APPAM-16910-2Discussant.pdf}
}

