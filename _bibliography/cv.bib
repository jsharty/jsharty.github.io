@unpublished{kim2022,
  type = {Invited session chair},
  title = {Racial and Ethnic Disparities in Overlapping Systems: Exploring Differentials in Child Welfare, Criminal Justice, and Child Support Policies},
  author = {Kim, Yoona and \hartyjsdot{Harty, Justin S.}},
  date = {2022-11-19},
  url = {https://appam.confex.com/appam/2022/meetingapp.cgi/Session/16892},
  abstract = {More policy attention has been paid to how effective human service programs are than to how equitably those programs are implemented. Although previous research provides suggestive evidence on ways in which program operations and treatment can induce disparities for socioeconomically marginalized groups, especially racial and ethnic minorities, it is not yet conclusive. This panel consists of four presentations that explicitly focus on whether and how racial and ethnic disparities arise in human services programs. All papers look at racial disparities resulting from low-income families’ involvement in overlapping systems, including the criminal legal system, child welfare, and family court. The first paper, “Overlapping Systems: Race and Ethnic Disparities in Parental Rights Termination Following Incarceration,” looks at the nexus between the criminal justice system and child welfare system involvement, both of which are common among families with racial and ethnic minority backgrounds. The paper examines the association between incarceration and loss of parental rights, whether the link varies across racialized groups, and, if it varies, why. The second paper, “The Legal Circuitry of Inequality: A Legal Census of Child Support Enforcement in California Law,” extends the connection of criminal justice policy to child support. The paper discusses the legal capacity of child support enforcement and its proximity to monetary sanctions as legal punishments that are disparate across racialized groups. The third paper, “Driver’s License Suspensions, Social Compliance, and the Reproduction of Racial Inequality,” brings a broader perspective to explore geographic variability in the use of drivers’ license suspensions. The paper investigates whether and how punishment for “social noncompliance” ironically creates additional structural barriers to compliance, especially for racially and ethnically marginalized communities. The final paper, “Understanding Racial Disparities in Child Support Arrears,” focuses on structural issues in the child support system. The paper describes racial and ethnic disparities both in mechanisms in the setting of the order through which noncustodial parents are penalized and in the link between these mechanisms and noncompliance that can lead to consequential penalties. All papers employ unique and rich data from administrative records to legislative code. The papers also leverage multiple research methods, from quantitative analyses of individual-level and zip-code level data and (qualitative) legal analysis. The chair, presenters and discussants reflect diversity across lines of race/ethnicity, gender, region, affiliation, and discipline. The panel’s chair and discussants are experts in practice and scholarship who have been particularly dedicated to the topic of racial and ethnic justice. The panel contributes to addressing fundamental issues pervasive in human services programs and opens up the opportunity to engage the audience in this timely and imperative discussion.},
  venue = {Association for Public Policy Analysis \& Management 44th Annual Research Conference, Washington, D.C.},
  keywords = {cv-conf-chair},
  file = {/Users/j-macmini/Zotero/storage/36DDI7J6/Kim and Harty - 2022 - Racial and ethnic disparities in overlapping systems exploring differentials in child welfare, crim.pdf;/Users/j-macmini/Zotero/storage/ZKUWS6VY/Conference-2022-APPAM-16892-2SessionChair.pdf}
}

