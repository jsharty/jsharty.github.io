---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- unless p.url contains '.json' or p.url contains '.xml' or p.url contains '.txt' or p.url contains '.css' or p.url == '/404.html' or p.sitemap == false -%}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>{% if p.url == '/' %}1.0{% else %}0.8{% endif %}</priority></url>
{%- endunless -%}
{%- endfor -%}
{%- for p in site.pubs %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.7</priority></url>
{%- endfor -%}
{%- for e in site.data.bib -%}{%- if e.files.paper and e.detail != '' %}
  <url><loc>{{ e.files.paper | absolute_url }}</loc><priority>0.6</priority></url>
{%- endif -%}{%- endfor %}
</urlset>
